{
  "name": "tokenremain-windows",
  "version": "1.2.6-windows.1",
  "private": true,
  "description": "TokenRemain for Windows with local usage and encrypted direct Mac sync",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "check": "node --check electron/main.js && node --check electron/preload.cjs && node --check electron/feed.js && node --check electron/local-usage.js && node --check electron/pricing.js && node --check electron/popover-placement.js && npm test && npm run build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:x64": "npm run build && electron-builder --x64 --win nsis --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.jamesli.tokenremain.windows",
    "productName": "TokenRemain",
    "asar": true,
    "asarUnpack": [
      "node_modules/@ccusage/**/bin/ccusage*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/provider-meta.js",
      "src/usage-history.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../site/assets/brand/appicon-mac.png",
        "to": "appicon.png"
      }
    ],
    "win": {
      "icon": "../site/assets/brand/appicon-mac.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "ccusage": "20.0.19"
  }
}
