"cookieguide.title" = "Connect %@ with a browser Cookie";
"cookieguide.summary" = "Uses your own %@ web session: sign in in your browser, copy the page request's Cookie header, then paste it here.";
"cookieguide.open" = "Open step-by-step guide";
"cookieguide.reopen" = "Open %@ again";
"cookieguide.step1.title" = "Sign in to %@";
"cookieguide.step1.body" = "%@ has opened in your browser. Sign in there if you aren’t already, and stay on that page.";
"cookieguide.step2.body.chromium" = "On the %@ page, press ⌥⌘I, or right-click the page and choose Inspect.";
