"cookieguide.step2.body.firefox" = "On the %@ page, press ⌥⌘I, or right-click the page and choose Inspect.";
"cookieguide.step3.title" = "Find the page request’s Cookie header";
"cookieguide.step3.body.chromium" = "Open the Network tab and press ⌘R to reload. Click the first request named %@ (type document), open Headers → Request Headers and find the cookie row.";
"cookieguide.step3.body.safari" = "Open the Network tab and press ⌘R to reload. Select the first %@ document, open Headers and find Cookie under Request.";
"cookieguide.step3.body.firefox" = "Open the Network tab and press ⌘R to reload. Select the first %@ document request, open Headers and find Cookie under Request Headers.";
"cookieguide.step4.title" = "Copy it and paste here";
"cookieguide.step4.body" = "Right-click the cookie row and choose Copy value (right-clicking the request → Copy as cURL works too), then click Paste from Clipboard. TokenRemain checks it once with %@ before saving.";
"cookieguide.connected" = "Connected. %@ usage now comes from this browser session.";
