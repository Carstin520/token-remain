{
  "name": "tokenremain-broadcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run deploy:dry-run",
    "db:migrate:local": "wrangler d1 migrations apply tokenremain-broadcast --local",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev --test-scheduled",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@rolldown/binding-darwin-arm64": "^1.1.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
